{
  "name": "svmpsp-dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync || echo '') && (husky || echo '')",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint src",
    "format": "prettier --write -l .",
    "format:check": "prettier --check .",
    "test": "pnpm vitest run --coverage",
    "db:seed": "pnpm tsx scripts/seed-blog.ts",
    "db:admin": "pnpm tsx scripts/create-admin.ts"
  },
  "packageManager": "pnpm@10.26.1",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.11.1",
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^24.10.11",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.3.1",
    "isomorphic-dompurify": "^2.35.0",
    "marked": "^16.4.2",
    "prisma": "^6.19.2"
  }
}
